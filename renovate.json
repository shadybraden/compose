{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended",  "docker:enableMajor"],
  "commitMessagePrefix": ":rocket:",
  "prConcurrentLimit": 32,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "commitMessagePrefix": ":adhesive_bandage:"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "commitMessagePrefix": ":boom:"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["searxng/searxng", "docker.io/searxng/searxng"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})(?:-[\\w]+)?$",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/linuxserver.io/jackett"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.n8n.io/n8nio/n8n"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["jgraph/drawio"],
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["rustmailer/bichon"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/rustmailer/bichon"
    },
    {
      "matchPackageNames": ["hugomods/hugo"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/gohugoio/hugo"
    },
    {
      "matchPackageNames": ["mongo"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://www.mongodb.com/docs/manual/release-notes/"
    },
    {
      "matchPackageNames": ["nextcloud"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://nextcloud.com/changelog/"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["linuxserver/mullvad-browser"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "matchPackageNames": ["quay.io/linuxserver.io/qbittorrent"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/qbittorrent/qBittorrent/"
    },
    {
      "matchPackageNames": ["ghcr.io/alexta69/metube"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/alexta69/metube"
    },
    {
      "matchPackageNames": ["mauriceboe/trek"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/mauriceboe/TREK"
    },
    {
      "matchPackageNames": ["postgres"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://www.postgresql.org/docs/release/"
    },
    {
      "matchPackageNames": ["ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder"],
      "versioning": "regex:^latest-build-(?<major>\\d+)$",
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/sdr-enthusiasts/docker-adsb-ultrafeeder",
      "commitMessagePrefix": ":✈️:"
    },
    {
      "matchPackageNames": ["nginx"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/nginx/nginx"
    },
    {
      "matchPackageNames": ["docker"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://docs.docker.com/engine/release-notes"
    },
    {
      "matchPackageNames": ["ghcr.io/umami-software/umami"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/umami-software/umami"
    },
    {
      "matchPackageNames": ["quay.io/linuxserver.io/sonarr"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/Sonarr/Sonarr/"
    },
    {
      "matchPackageNames": ["factoriotools/factorio"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://www.factorio.com/",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["ghcr.io/blakeblackshear/frigate"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/blakeblackshear/frigate"
    },
    {
      "matchPackageNames": ["hudik/hoodik"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/hudikhq/hoodik"
    },
    {
      "matchPackageNames": ["docker.io/actualbudget/actual-server"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/actualbudget/actual"
    },
    {
      "matchPackageNames": ["docker.io/valkey/valkey"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/valkey-io/valkey"
    },
    {
      "matchPackageNames": ["ghost"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/TryGhost/ghost"
    },
    {
      "matchPackageNames": ["mysql"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://dev.mysql.com/doc/relnotes/mysql/8.4/en/"
    },
    {
      "matchPackageNames": ["louislam/uptime-kuma"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/louislam/uptime-kuma"
    },
    {
      "matchPackageNames": ["cloudflare/cloudflared"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://github.com/cloudflare/cloudflared/blob/master/RELEASE_NOTES"
    },
    {
      "matchPackageNames": ["dock.mau.dev/mautrix/discord"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://mau.dev/mautrix/discord/-/blob/main/CHANGELOG.md"
    },
    {
      "matchPackageNames": ["traccar/traccar"],
      "matchDatasources": ["docker"],
      "sourceUrl": "https://www.traccar.org/blog/category/releases/"
    },
    {
      "matchPackageNames": ["clickhouse/clickhouse-keeper", "clickhouse/clickhouse-server"],
      "matchDatasources": ["docker"],
      "groupName": "clickhouse"
    },
    {
      "matchPackageNames": ["ghcr.io/fbuchner/meerkat-crm-backend", "ghcr.io/fbuchner/meerkat-crm-frontend"],
      "matchDatasources": ["docker"],
      "groupName": "meerkat"
    },
    {
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "matchDatasources": ["docker"],
      "versioning": "regex:^(?<compatibility>\\d+)-vectorchord(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-pgvectors\\d+\\.\\d+\\.\\d+$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["albrechtloh/openwrt-docker"],
      "versioning": "regex:^openwrt-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>[a-f0-9]+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["renovate/renovate"],
      "automerge": false,
      "minimumReleaseAge": "3 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)compose[^/]*\\.ya?ml$/"
      ],
      "matchStrings": [
        "postgres:(?<currentValue>\\d+\\.\\d+-alpine(?<compatibility>\\d+\\.\\d+))"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-alpine(?<patch>\\d+)\\.(?<build>\\d+)$"
    }
  ]
}
